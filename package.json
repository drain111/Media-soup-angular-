{
  "name": "mediasoupangular",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run start -w client",
    "dev": "concurrently -k -n \"CLIENT,SERVER\" -c \"blue,green\" \"npm run dev:client\" \"npm run dev:server\"",
    "build:client": "npm run build -w client",
    "build:server": "npm run build -w server",
    "build": "npm run build:client && npm run build:server",
    "start": "npm run start -w server",
    "start:prod-linux": " node -r dotenv/config server/dist/main.js dotenv_config_path=.env.production",
    "test": "npm run test -w server",
    "start:prod-win": "$env:ALLOW_FAKE_AUTH='production';$env:NODE_ENV='production';$env:SESSION_SECRET='dev-only-secret-change-me-0123456789abcdef';$env:PUBLIC_URL='http://localhost:3001';$env:PORT='3001';node server/dist/main.js",
    "lint": "npm run lint -w client && npm run lint -w server",
    "compose:up": "podman compose up -d",
    "compose:down": "podman compose down"
  },
  "dependencies": {
    "@angular/compiler": "^22.2.1",
    "@angular/platform-server": "^22.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.7",
    "esbuild": "^0.28.2",
    "express": "5.2.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "msgpackr-extract@3.0.4": true,
    "lmdb@3.5.6": true,
    "mediasoup@3.27.1": true,
    "@parcel/watcher@2.6.0": true
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
